{
  "hosting": {
    "public": "public",
    "ignore": ["**/.*"],
    "headers": [
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ] },
      { "source": "/@(index.html|sw.js|config.js|app.js|app.css|logic.js|hebrew.js|manifest.webmanifest)", "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ] }
    ]
  },
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "functions": [{
    "source": "functions",
    "codebase": "default",
    "runtime": "nodejs22",
    "predeploy": ["cp \"$PROJECT_DIR/public/logic.js\" \"$RESOURCE_DIR/logic.js\""]
  }],
  "emulators": {
    "firestore": { "port": 8080 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
